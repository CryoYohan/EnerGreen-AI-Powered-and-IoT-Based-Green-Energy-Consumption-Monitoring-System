rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Helper function to check admin role
    function isAdmin() {
      return request.auth != null &&
        get(
          /databases/$(database)/documents/artifacts/default-app-id/users/$(request.auth.uid)/userProfile/profile
        ).data.role == "admin";
    }

    // ✅ Helper function to check if user owns device
    function ownsDevice(deviceId) {
      return request.auth != null &&
        get(
          /databases/$(database)/documents/artifacts/default-app-id/users/$(request.auth.uid)/userProfile/profile
        ).data.deviceId == deviceId;
    }
    
    // ✅ NEW: Helper function to check if target user exists and admin is modifying
    function isAdminUpdatingUserProfile(userId) {
      return isAdmin() && exists(/databases/$(database)/documents/artifacts/default-app-id/users/$(userId));
    }

    // ---- Realtime readings ----
    match /devices/{deviceId}/realtime_readings/{readingId} {
      allow read, write: if ownsDevice(deviceId); // Allows the user to query and read the collection
    }

    // ---- Appliances ----
    match /devices/{deviceId}/appliances/{applianceId} {
      allow read: if ownsDevice(deviceId); // Allows the user to query and read the collection
    }
		
    // ---- Daily Summaries (NEW RULE) ----
    match /devices/{deviceId}/daily_summaries/{dateId} {
      allow read: if ownsDevice(deviceId); // Allows the owner to read their daily aggregation data
    }

    // ---- Devices root ----
    match /devices/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // ---- Appliance Predictions ----
    match /devices/{deviceId}/appliance_predictions/{predictionId} {
      allow read, write: if ownsDevice(deviceId);
    }

    // ---- AI Models ----
    match /devices/{deviceId}/models/{modelId} {
      allow read: if ownsDevice(deviceId);
    }

    // ---- Clusters ----
    match /devices/{deviceId}/clusters/{clusterId} {
      allow read, write: if ownsDevice(deviceId);
    }

    // ---- Confirmed Appliances ----
    match /devices/{deviceId}/confirmed_appliances/{applianceId} {
      allow read, write: if ownsDevice(deviceId);
    }

    // ---- Device Predictions ----
    match /devices/{deviceId}/predictions/{predictionId} {
      allow read, write: if ownsDevice(deviceId);
    }

    // ---- Public data ----
    match /artifacts/{appId}/public/data/{collection}/{documentId} {
      allow read: if request.auth != null;
    }

    // ---- User Root Document ----
    match /artifacts/{appId}/users/{userId} {
      allow delete, update, read: if isAdmin();
    }

    // ---- Private user data (userProfile) ----
    match /artifacts/{appId}/users/{userId}/userProfile/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      // NEW: Allow admin to write to any user's profile (for status updates)
      allow write: if isAdminUpdatingUserProfile(userId);
    }

    // 🔑 Admin collectionGroup rule (for queries across all userProfiles)
    match /{path=**}/userProfile/{docId} {
      allow read: if isAdmin();
    }

    // ---- AI Model retraining (admin only) ----
    match /admin/models/{modelId} {
      allow write: if isAdmin();
    }

    // ---- Catch-all ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
